# E-mail (sign-in codes and alert e-mails). With both set, sign-in switches to e-mail codes only.
RESEND_API_KEY=
EMAIL_FROM=                # e.g. "Store Launch Tracker <storelaunch@sangeetha.com>" (domain verified in Resend)
APP_URL=                   # link used in e-mails, e.g. https://sangeetha-store-tracker.vercel.app
# LOGIN_MODE=code          # force "code" or "password" (development: the code is printed to the console)
# DEMO_PASSWORD_LOGIN=1    # keep passwords for the …@sangeetha.test demo accounts when codes are on
